# =============================================================================
# .env.example - Environment variables template
# =============================================================================
# Usage:
#   1. Copy this file to `.env`:        cp .env.example .env
#   2. Fill in the real values in `.env` (which is gitignored)
#   3. Source it before running scripts: set -a && source .env && set +a
#
# NEVER commit your `.env` file to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Judge model (used by examples/HyperEyes/llm_judge.py)
# -----------------------------------------------------------------------------
# Either set SLYCHAT_* variants or fall back to OPENAI_* variants.
SLYCHAT_JUDGE_API_KEY=
SLYCHAT_JUDGE_BASE_URL=
SLYCHAT_JUDGE_MODELS=
SLYCHAT_JUDGE_TIMEOUT=120

# OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# Gemini Flash API (used by examples/HyperEyes/llm_judge.py)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_FLASH_URL=

# -----------------------------------------------------------------------------
# Agent / Tool config (used by HyperEyes_RL.sh)
# -----------------------------------------------------------------------------
MAX_TOOL_CALLS_NUM=8
MAX_ITERATIONS=9
RAG_MAX_CONCURRENCY=64

# -----------------------------------------------------------------------------
# Training run identifiers
# -----------------------------------------------------------------------------
QS_USER=
PROJECT_NAME=
EXP_NAME=

# -----------------------------------------------------------------------------
# Paths (model / save / dataset)
# -----------------------------------------------------------------------------
MODEL_DIR=
SAVE_DIR=
DATSET_DIR=

# -----------------------------------------------------------------------------
# ClearML (set these and `clearml-init` will pick them up; do NOT hard-code
# the values into shell scripts)
# -----------------------------------------------------------------------------
CLEARML_WEB_HOST=
CLEARML_API_HOST=
CLEARML_FILES_HOST=
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
